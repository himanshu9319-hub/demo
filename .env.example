# Select `google` only when a restricted Maps JavaScript API key is configured.
VITE_MAPS_PROVIDER=osm
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_URL=http://127.0.0.1:8000/api/v1
VITE_API_POLL_MS=5000

# Optional demo-only hint shown on the staff login pages (leave empty to hide the password hint).
VITE_DEMO_DOCTOR_PASSWORD=
VITE_DEMO_RECEPTION_PASSWORD=
